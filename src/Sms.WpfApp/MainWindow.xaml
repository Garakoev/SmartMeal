<Window x:Class="Sms.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тестовое WPF-приложение для SmartMealService"
        Width="1288" Height="650" MinWidth="860" MinHeight="430"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" UseLayoutRounding="True" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="46" /><Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F0F1DF" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E8ECC4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#242424" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="17" />
            <Setter Property="Padding" Value="12,7" /><Setter Property="BorderBrush" Value="#888888" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F4F7D6" /><Setter Property="Foreground" Value="#262626" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#FAFCEB" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRowHeader">
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#888888" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,12" /><Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#363636" />
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="MaxHeight" Value="150" />
        </Style>
    </Window.Resources>
    <Border Margin="28" Background="White" CornerRadius="42">
        <Border.Effect><DropShadowEffect Color="#EAF29D" BlurRadius="45" ShadowDepth="0" Opacity="0.8" /></Border.Effect>
        <Grid Margin="30,18,30,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="62" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="OnTitleDrag">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Тестовое WPF-приложение для SmartMealService" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Margin="0,0,16,0" Click="OnMinimize" ToolTip="Свернуть" AutomationProperties.Name="Свернуть">
                    <Rectangle Width="24" Height="4" Fill="{StaticResource Ink}" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Click="OnClose" ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
                    <Path Data="M 2,2 L 24,24 M 24,2 L 2,24" Stroke="{StaticResource Ink}" StrokeThickness="8" Width="28" Height="28" Stretch="Uniform" />
                </Button>
            </Grid>
            <Border Grid.Row="1" CornerRadius="36" BorderBrush="{StaticResource Ink}" BorderThickness="3" Padding="0">
                <Grid SizeChanged="OnTableSizeChanged">
                    <DataGrid x:Name="VariablesGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              CanUserSortColumns="False" Background="White" BorderThickness="0" FontSize="15"
                              HorizontalGridLinesBrush="#999999" VerticalGridLinesBrush="#999999"
                              HeadersVisibility="All" RowHeaderWidth="38" MinRowHeight="48"
                              SelectionMode="Single" SelectionUnit="Cell" GridLinesVisibility="All"
                              CellEditEnding="OnCellEditEnding" PreviewKeyDown="OnGridKeyDown"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Поле" Width="1.05*" MinWidth="210" IsReadOnly="True" Binding="{Binding Name}" ElementStyle="{StaticResource CellText}" />
                            <DataGridTemplateColumn Header="Значение" Width="1.2*" MinWidth="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Value}" Style="{StaticResource CellText}" ToolTip="{Binding Value}" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, Mode=OneTime}" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="46" MaxHeight="180" Padding="10" BorderThickness="1" BorderBrush="#A3B640"
                                                 VerticalScrollBarVisibility="Auto" Loaded="OnEditorLoaded"
                                                 ToolTip="Ctrl+Enter или Tab — сохранить; Esc — отменить; Enter — новая строка" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Комментарий" Width="1.4*" MinWidth="180" IsReadOnly="True" Binding="{Binding Comment}" ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Margin="5,13,5,0" FontSize="12" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#656565" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="#AA3028" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Border>
</Window>
